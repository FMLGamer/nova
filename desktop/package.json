{
  "name": "nova-desktop",
  "productName": "Nova",
  "version": "2.4.0",
  "description": "Nova for desktop: your media, your plugins, streamed on your own computer.",
  "license": "MIT",
  "author": "Nova contributors",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "start": "electron .",
    "dist": "node scripts/stage.mjs && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "build": {
    "appId": "app.nova.desktop",
    "productName": "Nova",
    "copyright": "Nova contributors",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "discord.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "app"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Nova-${version}-win.${ext}",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": null,
      "artifactName": "Nova-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Movies, shows, anime, live TV and books in one place",
      "artifactName": "Nova-${version}-linux-${arch}.${ext}",
      "target": [
        "AppImage",
        "tar.gz"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Nova",
      "artifactName": "Nova-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Nova-Portable-${version}.${ext}",
      "splashImage": "build/splash.bmp",
      "useZip": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.12"
  }
}
